{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "services/*/tests/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist/**"]
}
