# Copy to .env (never commit .env). All secrets server-side only.
# Trading defaults to PAPER simulation. Never enable LIVE automatically.

# --- Core ---
TRADING_MODE=PAPER
LOG_LEVEL=info

# --- Postgres / Redis ---
DATABASE_URL=postgres://arb:arb@localhost:5432/arb
REDIS_URL=redis://localhost:6379

# --- Arb thresholds ---
MIN_NET_ROI=0.01
MIN_NET_PROFIT=5
MAX_CAPITAL_PER_TRADE=1000
MAX_SLIPPAGE=0.005
MAX_OPPORTUNITY_AGE_MS=1000
MATCH_CONFIDENCE_THRESHOLD=0.95

# --- Risk limits ---
MAX_CAPITAL_PER_VENUE=5000
MAX_DAILY_LOSS=500
MAX_OPEN_POSITIONS=10
MAX_EVENT_EXPOSURE=2000
MAX_ORDER_SIZE=1000
MAX_MARKET_AGE_MS=5000

# --- Venue credentials (server-side only; leave empty until verified) ---
# Polymarket docs: https://docs.polymarket.com — verify Gamma + CLOB endpoints before live use.
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Kalshi docs: https://docs.kalshi.com (trade API v2) — verify before live use.
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
# Betfair docs: https://docs.developer.betfair.com — verify API-NG + certs before live use.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_URL=
ALERT_WEBHOOK_URL=

# --- Dashboard auth ---
DASHBOARD_JWT_SECRET=
API_PORT=3001
